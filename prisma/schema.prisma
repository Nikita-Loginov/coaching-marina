generator client {
  provider   = "prisma-client"
  output     = "../src/generated"
  // engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id         String   @id
  name       String
  middlename String
  post       String
  img        String
  imgAlt     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Person {
  id                       String   @id @default("main")
  name                     String
  middlename               String
  fullname                 String
  post                     String
  clients                  String
  countAreas               Int
  license                  String   @default("Л035-01255-50/01533168")

  about                    Json
  contacts                 Json
  socials                  Json
  practice                 Json
  organization             Json
  management               Json
  education                Json
  materialTechnicalSupport Json
  paidEducationalServices  Json

  financialActivity        Json
  vacantPlaces             Json
  studentSupport           Json
  internationalCooperation Json
  documents                Json

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Program {
  id                   String   @id
  name                 String
  description          String[]
  descriptionFull      String[]
  as                   String
  btnText              String

  img                  Json

  forWhom              Json
  suitableRequests     Json
  workflow             Json
  cooperationFormat    Json
  benefits             Json

  reviews              Json?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}